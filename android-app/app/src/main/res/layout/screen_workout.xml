<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="28dp"
    android:paddingRight="20dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tập luyện"
        android:textColor="@color/gr_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/workout_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="4dp"
        android:text="Tạo lịch tập để mở 3 bài cơ bản và thử hệ thống tính rank theo nhóm cơ."
        android:textColor="@color/gr_text_muted"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/workout_primary_action"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card_blue"
        android:gravity="center"
        android:text="Tạo lịch tập"
        android:textColor="@color/gr_background"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/workout_list"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:nestedScrollingEnabled="false"
        android:visibility="gone" />
</LinearLayout>
