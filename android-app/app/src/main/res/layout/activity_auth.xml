<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/auth_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gr_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingTop="34dp"
            android:paddingRight="22dp"
            android:paddingBottom="22dp">

            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center"
                android:text="GR"
                android:textColor="@color/gr_background"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/auth_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Chào mừng đến GymRank"
                android:textColor="@color/gr_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/auth_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="Đăng nhập để đồng bộ level, rank và chuỗi tập của bạn."
                android:textColor="@color/gr_text_muted"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/login_mode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_selected"
                    android:gravity="center"
                    android:text="Đăng nhập"
                    android:textColor="@color/gr_background"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/register_mode"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_normal"
                    android:gravity="center"
                    android:text="Đăng ký"
                    android:textColor="@color/gr_text_muted"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/display_name_input"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_input"
                android:hint="Tên hiển thị"
                android:inputType="textPersonName"
                android:maxLines="1"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:textColor="@color/gr_text"
                android:textColorHint="@color/gr_text_dim"
                android:textSize="16sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/email_input"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:maxLines="1"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:textColor="@color/gr_text"
                android:textColorHint="@color/gr_text_dim"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input"
                android:hint="Mật khẩu tối thiểu 6 ký tự"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:textColor="@color/gr_text"
                android:textColorHint="@color/gr_text_dim"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/auth_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:text="Hồ sơ và tiến trình tập luyện của bạn sẽ được đồng bộ trực tuyến."
                android:textColor="@color/gr_text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/auth_primary_button"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_blue"
                android:gravity="center"
                android:text="Đăng nhập"
                android:textColor="@color/gr_background"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/google_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_option_normal"
                android:gravity="center"
                android:text="Tiếp tục với Google"
                android:textColor="@color/gr_text"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
