<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="28dp"
    android:paddingRight="20dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cơ thể"
        android:textColor="@color/gr_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/bodygraph_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Chưa có dữ liệu rank"
        android:textColor="@color/gr_text_muted"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/bodygraph_front_container"
                    android:layout_width="match_parent"
                    android:layout_height="360dp">

                    <ImageView
                        android:id="@+id/bodygraph_front_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="Bodygraph mặt trước"
                        android:scaleType="fitCenter"
                        android:src="@drawable/bodygraph_male_front" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Trước"
                    android:textColor="@color/gr_text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/bodygraph_back_container"
                    android:layout_width="match_parent"
                    android:layout_height="360dp">

                    <ImageView
                        android:id="@+id/bodygraph_back_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:adjustViewBounds="true"
                        android:contentDescription="Bodygraph mặt sau"
                        android:scaleType="fitCenter"
                        android:src="@drawable/bodygraph_male_back" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Sau"
                    android:textColor="@color/gr_text_muted"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phân tích nhóm cơ"
            android:textColor="@color/gr_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/body_rank_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="Mỗi nhóm cơ sẽ lên rank riêng dựa trên bài tập bạn đã lưu."
            android:textColor="@color/gr_text_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/body_rank_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
